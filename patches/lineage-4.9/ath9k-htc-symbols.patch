-	return htc_connect_service(priv->htc, &req, ep_id);
+	return ath9k_htc_hst_connect_service(priv->htc, &req, ep_id);
 }
 
 static int ath9k_init_htc_services(struct ath9k_htc_priv *priv, u16 devid,
@@ -207,7 +207,7 @@ static int ath9k_init_htc_services(struct ath9k_htc_priv *priv, u16 devid,
 	else
 		priv->htc->credits = 33;
 
